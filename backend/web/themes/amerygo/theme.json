      "scope": "index"
    },
    {
      "id": "testimonials_list",
      "type": "repeater",
      "label": "Daftar Testimoni",
      "scope": "index",
      "schema": [
        {
          "id": "name",
          "type": "text",
          "label": "Nama",
          "default": "John Doe"
        },
        {
          "id": "role",
          "type": "text",
          "label": "Jabatan/Tim",
