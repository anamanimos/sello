      ],
      "default": [
        {
          "name": "Paket Basic",
          "price": "Rp 150.000",
          "feature1": "Jersey 1 pcs",
          "feature2": "Printing sublim",
          "feature3": "Desain standar",
          "feature4": "",
          "feature5": "",
          "is_popular": false
        },
        {
          "name": "Paket Team",
          "price": "Rp 1.500.000",
          "feature1": "Jersey 12 pcs",
          "feature2": "Printing premium",
          "feature3": "Custom desain",
          "feature4": "Nama & nomor punggung",
          "feature5": "",
          "is_popular": true
        },
        {
          "name": "Paket Club",
          "price": "Rp 3.000.000",
          "feature1": "Jersey 25 pcs",
          "feature2": "Printing premium",
          "feature3": "Full custom desain",
          "feature4": "Nama & nomor punggung",
          "feature5": "Celana + kaos kaki",
          "is_popular": false
        }
      ]
    },
    {
      "type": "header",
      "content": "Testimoni Section"
    },
    {
      "id": "testimonials_title",
      "type": "text",
      "label": "Judul Section Testimoni",
      "default": "Apa Kata <span class='text-orange'>Mereka</span>?",
      "scope": "index"
    },
    {
      "id": "testimonials_subtitle",
      "type": "text",
      "label": "Sub-Judul Testimoni",
