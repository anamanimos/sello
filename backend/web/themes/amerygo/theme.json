        },
        {
          "name": "Budi Santoso",
          "role": "Manager, Storm Esports",
          "quote": "Sudah 3x order di Amerygo, selalu puas dengan hasilnya. Recommended banget!",
          "avatar": ""
        },
        {
          "name": "Dewi Lestari",
          "role": "Sekretaris, Futsal Wanita Jakarta",
          "quote": "Bahan nyaman, printing awet, dan pelayanan ramah. Pasti order lagi!",
          "avatar": ""
