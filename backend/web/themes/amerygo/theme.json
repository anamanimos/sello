      "default": [
        {
          "name": "Andi Pratama",
          "role": "Captain, Garuda FC",
          "quote": "Jersey berkualitas tinggi dengan desain yang sesuai keinginan tim. Pengerjaan cepat dan hasil memuaskan!",
