{
  "name": "Amerygo",
  "slug": "amerygo",
  "description": "Premium Sportswear Theme with Dark Header and Orange Accents",
  "version": "1.0.0",
  "thumbnail_url": "/themes/amerygo/assets/img/thumbnail.jpg",
  "allowed_user_ids": [],
  "templates": {
    "index": "home.html",
    "product": "product.html"
  },
  "settings": [
    {
      "type": "header",
      "content": "Brand Identity"
    },
    {
      "id": "primary_color",
      "type": "color",
      "label": "Primary Color (Orange)",
      "default": "#f75c03",
      "scope": "global"
    },
    {
      "id": "secondary_color",
      "type": "color",
      "label": "Secondary Color (Dark)",
      "default": "#1a1a1a",
      "scope": "global"
    },
    {
      "id": "background_color",
      "type": "color",
      "label": "Background Color",
      "default": "#ffffff",
      "scope": "global"
    },
    {
      "type": "header",
      "content": "Hero Section"
    },
    {
      "id": "hero_title",
      "type": "text",
      "label": "Hero Title",
      "default": "Wujudkan <span class='text-highlight'>Identitas Tim</span> dengan Jersey Premium",
      "scope": "index"
    },
    {
      "id": "hero_subtitle",
      "type": "text",
      "label": "Hero Subtitle",
      "default": "Jasa custom jersey dan ready stock terbaik untuk futsal, sepak bola, esports, dan komunitas Anda.",
      "scope": "index"
    },
    {
      "id": "hero_image",
      "type": "image",
      "label": "Hero Image",
      "default": "/themes/amerygo/assets/img/hero.jpg",
      "scope": "index"
    },
    {
      "type": "header",
      "content": "Hero Buttons"
    },
    {
      "id": "hero_btn_catalog_text",
      "type": "text",
      "label": "Teks Tombol Katalog",
      "default": "Lihat Katalog",
