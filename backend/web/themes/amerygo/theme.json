    {
      "type": "header",
      "content": "Product Detail"
    },
    {
      "id": "back_home_text",
      "type": "text",
      "label": "Teks Kembali Home (Navbar)",
      "default": "Kembali ke Home",
      "scope": "product"
    },
    {
      "id": "back_text",
      "type": "text",
      "label": "Teks Kembali",
      "default": "Kembali",
      "scope": "product"
    },
    {
      "id": "order_now_text",
      "type": "text",
      "label": "Teks Tombol Pesan",
      "default": "Pesan Sekarang",
      "scope": "product"
    },
    {
      "id": "whatsapp_template_text",
      "type": "text",
      "label": "Template Pesan WA",
      "default": "Halo, saya tertarik dengan {{product.name}}",
      "scope": "product"
    },
    {
      "id": "whatsapp_btn_color",
      "type": "color",
      "label": "Warna Tombol WA",
      "default": "#25D366",
      "scope": "product"
    },
    {
      "type": "header",
      "content": "Why Choose Us (Features)"
    },
    {
      "id": "features_title",
      "type": "text",
      "label": "Judul Section",
      "default": "Keunggulan Kami",
      "scope": "index"
    },
    {
      "id": "features_list",
      "type": "repeater",
      "label": "Daftar Keunggulan",
      "scope": "index",
      "schema": [
        {
          "id": "icon",
          "type": "icon",
          "label": "Icon Class (FontAwesome)",
          "default": "fas fa-check"
        },
        {
          "id": "title",
          "type": "text",
          "label": "Judul",
          "default": "Judul Fitur"
        },
        {
          "id": "desc",
          "type": "text",
          "label": "Deskripsi",
          "default": "Deskripsi singkat fitur."
        }
      ],
      "default": [
        {
          "icon": "fas fa-tshirt",
          "title": "Bahan Premium",
          "desc": "Menggunakan bahan dryfit kualitas ekspor yang nyaman."
        },
        {
          "icon": "fas fa-bolt",
          "title": "Pengerjaan Cepat",
          "desc": "Proses produksi on-time dengan quality control ketat."
        },
        {
          "icon": "fas fa-palette",
          "title": "Custom Desain",
          "desc": "Bebas request desain sesuai identitas tim Anda."
        }
      ]
    },
    {
      "type": "header",
      "content": "Paket Section"
    },
    {
      "id": "packages_title",
      "type": "text",
      "label": "Judul Section Paket",
      "default": "Paket <span class='text-orange'>Jersey</span>",
