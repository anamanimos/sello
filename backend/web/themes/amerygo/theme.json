    },
    {
      "id": "hero_btn_consult_text",
      "type": "text",
      "label": "Teks Tombol Konsultasi",
      "default": "Konsultasi",
      "scope": "index"
    },
    {
      "type": "header",
      "content": "Catalog Section"
    },
    {
      "id": "catalog_title",
      "type": "text",
      "label": "Judul Katalog",
      "default": "Katalog <span class='text-orange'>Produk</span>",
      "scope": "index"
    },
    {
      "id": "catalog_subtitle",
      "type": "text",
      "label": "Sub-Judul Katalog",
      "default": "Pilihan terbaik untuk Anda",
      "scope": "index"
