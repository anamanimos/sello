      "scope": "index"
    },
    {
      "id": "packages_list",
      "type": "repeater",
      "label": "Daftar Paket",
      "scope": "index",
      "schema": [
        {
          "id": "name",
          "type": "text",
          "label": "Nama Paket",
          "default": "Paket Basic"
        },
        {
          "id": "price",
          "type": "text",
          "label": "Harga",
          "default": "Rp 150.000"
        },
        {
          "id": "feature1",
          "type": "text",
          "label": "Fitur 1",
          "default": "Jersey 1 pcs"
        },
        {
          "id": "feature2",
          "type": "text",
          "label": "Fitur 2",
          "default": "Printing sublim"
        },
        {
          "id": "feature3",
          "type": "text",
          "label": "Fitur 3",
          "default": "Desain standar"
        },
        {
          "id": "feature4",
          "type": "text",
          "label": "Fitur 4",
          "default": ""
